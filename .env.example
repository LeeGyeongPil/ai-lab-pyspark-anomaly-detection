# All optional. This demo needs no API key and no network after install.
# Output language: en | ko (the --lang option wins over this)
# PYSPARK_ANOMALY_LANG=en
# Java 17+ location (otherwise found via /usr/libexec/java_home or PATH)
# JAVA_HOME=
# Spark scratch folder (otherwise ./.spark-tmp is used)
# SPARK_LOCAL_DIRS=
